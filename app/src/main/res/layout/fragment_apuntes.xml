<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPageBackground">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="100dp">

            <TextView
                android:id="@+id/tvApuntesTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mis Apuntes"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvApuntesSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Todos tus apuntes en un solo lugar"
                android:textSize="13sp"
                android:textColor="@color/colorTextSecondary"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvSubjectFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Todas las materias ▾"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"
                android:textColor="@color/colorAccentPurple" />

            <LinearLayout
                android:id="@+id/searchBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_search_bar"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="Buscar"
                    android:layout_marginEnd="10dp" />

                <EditText
                    android:id="@+id/etSearchNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="Buscar por título…"
                    android:textColor="@color/colorTextPrimary"
                    android:textColorHint="@color/colorTextSecondary"
                    android:textSize="14sp"
                    android:inputType="text"
                    android:maxLines="1"
                    android:imeOptions="actionSearch" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/apuntesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <!-- Speed-dial scrim -->
    <View
        android:id="@+id/fabScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:alpha="0"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true" />

    <!-- Speed-dial stack -->
    <LinearLayout
        android:id="@+id/fabSpeedDialContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:orientation="vertical"
        android:gravity="end">

        <!-- Camera row -->
        <LinearLayout
            android:id="@+id/fabRowCamera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp"
            android:alpha="0"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Foto"
                android:textColor="@color/colorTextPrimary"
                android:textSize="13sp"
                android:background="@color/colorCardBackground"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginEnd="12dp"
                android:elevation="4dp" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabCamera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Tomar foto"
                android:src="@drawable/ic_camera"
                app:fabSize="mini"
                app:backgroundTint="@color/colorCardBackground"
                app:tint="@color/colorAccentPurple" />
        </LinearLayout>

        <!-- Pencil (note) row -->
        <LinearLayout
            android:id="@+id/fabRowNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp"
            android:alpha="0"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apunte"
                android:textColor="@color/colorTextPrimary"
                android:textSize="13sp"
                android:background="@color/colorCardBackground"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginEnd="12dp"
                android:elevation="4dp" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Crear apunte"
                android:src="@drawable/ic_edit"
                app:fabSize="mini"
                app:backgroundTint="@color/colorCardBackground"
                app:tint="@color/colorAccentPurple" />
        </LinearLayout>

        <!-- Main FAB -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAddNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Crear"
            android:src="@drawable/ic_add"
            app:backgroundTint="@color/colorAccentPrimary"
            app:tint="@color/white" />

    </LinearLayout>

</FrameLayout>
